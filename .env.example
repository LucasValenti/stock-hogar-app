# Copiá este archivo a .env y completá los valores. .env no se sube a git.
# Las variables VITE_* quedan dentro de la web: nunca pongas acá claves secretas.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Origen de los datos: memoria | supabase
VITE_DATOS=memoria
# VITE_DATOS=supabase

# Solo con VITE_DATOS=memoria: quién usa la casa de ejemplo.
# ejemplo-ana (admin, por defecto), ejemplo-bruno o ejemplo-caro.
# VITE_YO=ejemplo-bruno


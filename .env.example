# Copiá este archivo a .env y completá los valores. .env no se sube a git.
# Las variables EXPO_PUBLIC_* quedan dentro de la app: nunca pongas acá claves secretas.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origen de los datos: memoria | supabase
EXPO_PUBLIC_DATOS=memoria
# EXPO_PUBLIC_DATOS=supabase

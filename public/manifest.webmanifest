{
  "name": "Stock del hogar",
  "short_name": "Stock",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#dce8e3",
  "theme_color": "#dce8e3",
  "icons": [
    { "src": "/icono-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icono-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "comprobante", "accept": ["image/*", "application/pdf", ".pdf"] }
      ]
    }
  }
}
